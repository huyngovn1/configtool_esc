  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralWidget { background: #f4f7fb; color: #1f2937; }
QWidget { font-family: &quot;Segoe UI&quot;; font-size: 10pt; }
QFrame#headerFrame { background: #172033; border-radius: 10px; }
QLabel#titleLabel { color: white; font-size: 20pt; font-weight: 700; }
QLabel#subtitleLabel { color: #a9b7cf; }
QGroupBox { background: white; border: 1px solid #dce3ed; border-radius: 8px; margin-top: 12px; padding-top: 9px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 5px; color: #334155; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit { background: white; border: 1px solid #cbd5e1; border-radius: 5px; padding: 4px 7px; selection-background-color: #2563eb; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid #2563eb; }
QPushButton { min-height: 27px; padding: 3px 12px; border: 1px solid #cbd5e1; border-radius: 5px; background: #ffffff; }
QPushButton:hover { background: #eef4ff; border-color: #8fb3f4; }
QPushButton:pressed { background: #dce9ff; }
QPushButton:disabled { color: #94a3b8; background: #f1f5f9; }
QPushButton#connectButton, QPushButton#writeButton, QPushButton#flashFirmwareButton { color: white; background: #2563eb; border-color: #2563eb; font-weight: 600; }
QPushButton#connectButton:hover, QPushButton#writeButton:hover, QPushButton#flashFirmwareButton:hover { background: #1d4ed8; }
QLabel#linkLabel { color: #047857; font-weight: 600; }
QLabel#deviceLabel { color: #334155; background: #eaf1fb; border-radius: 5px; padding: 5px 9px; }
QLabel#settingsHint { color: #1e40af; background: #eaf2ff; border: 1px solid #c7dcff; border-radius: 6px; padding: 7px 10px; }
QLabel#dirtyLabel { color: #475569; font-weight: 600; }
QTabWidget::pane { border: 1px solid #d8e0eb; background: white; top: -1px; }
QTabBar::tab { background: #e8edf5; border: 1px solid #d8e0eb; padding: 8px 18px; margin-right: 2px; }
QTabBar::tab:selected { background: white; color: #1d4ed8; font-weight: 600; border-bottom-color: white; }
QProgressBar { border: 1px solid #cbd5e1; border-radius: 5px; background: #eef2f7; text-align: center; }
QProgressBar::chunk { background: #22c55e; border-radius: 4px; }
QScrollArea { border: none; background: white; }
QScrollArea &gt; QWidget &gt; QWidget { background: white; }
QPlainTextEdit#logView, QPlainTextEdit#rawView { font-family: &quot;Consolas&quot;; font-size: 9pt; }</string>
